# Copy this file to .env and fill in real values: cp .env.example .env
# Add every new variable name here (without the real value) so teammates know it exists.

# Backend
PORT=5000
DATABASE_URL=

# Third-party APIs
API_KEY=

# Frontend (React reads only variables with this prefix: REACT_APP_ for CRA, VITE_ for Vite)
REACT_APP_API_URL=http://localhost:5000
