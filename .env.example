# Copy to .env for local overrides: cp .env.example .env

# ClearCursor Sidecar & API
CLEARCURSOR_HOST=127.0.0.1
CLEARCURSOR_PORT=8000
CLEARCURSOR_DB_PATH=
CLEARCURSOR_LOG_LEVEL=warning
# Optional shared secret for local API/WebSocket auth (auto-generated when launched by Tauri)
CLEARCURSOR_API_TOKEN=

# Camera & Gaze Control
GAZE_CAMERA_INDEX=0
# Gaze tracker: auto/eyetrax/hybrid = MediaPipe head + EyeTrax eyes; mediapipe = MediaPipe only
GAZE_BACKEND=auto
# Pointing source: head or eyes
GAZE_INPUT=head

# SteadyHand Stabilization
STEADYHAND_ENABLED=1
STEADYHAND_STRENGTH=0.95

# Speech
TTS_ENABLED=1
TTS_RATE=175

# Optional ONNX / local prediction
ONNX_MODEL_PATH=
PREDICTION_ENABLED=0
