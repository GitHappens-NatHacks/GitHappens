# Copy to .env: cp .env.example .env

# Camera
GAZE_CAMERA_INDEX=0
# Gaze tracker: auto/eyetrax/hybrid = MediaPipe head + EyeTrax eyes; mediapipe = MediaPipe only
# Head pointing always uses the original MediaPipe method.
GAZE_BACKEND=auto
# Pointing source: head or eyes
GAZE_INPUT=head

# SteadyHand
STEADYHAND_ENABLED=1
STEADYHAND_STRENGTH=0.7

# Speech
TTS_ENABLED=1
TTS_RATE=175

# Optional ONNX / local prediction
ONNX_MODEL_PATH=
PREDICTION_ENABLED=0
