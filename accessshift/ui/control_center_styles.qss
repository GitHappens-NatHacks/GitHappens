/* AccessShift AI desktop control center. Uses built-in Qt widgets on macOS/Windows. */
QWidget#appRoot { background-color: #F5F7FC; color: #1B2540; }
QFrame#sidebar { background-color: #FFFFFF; border-right: 1px solid #E8ECF4; }
QLabel { color: #1D2941; background: transparent; }
QLabel#logoMark { color: #FFFFFF; background: #684CF6; border-radius: 13px; font-size: 23px; font-weight: 700; }
QLabel#brandName { font-size: 20px; font-weight: 800; color: #19223D; }
QLabel#brandSub { color: #929AB0; font-size: 11px; }
QLabel#sideSection { font-size: 10px; font-weight: 800; color: #98A1B5; letter-spacing: 1px; }
QPushButton#navButton { color: #56627A; background: transparent; border: none; border-radius: 12px; text-align: left; padding: 13px 18px; font-weight: 600; font-size: 13px; }
QPushButton#navButton:hover { background: #F5F2FF; color: #5C45D9; }
QPushButton#navButton:checked { background: #F0ECFF; color: #593FD7; }
QLabel#sidebarFoot { color: #96A0B5; font-size: 11px; }
QLabel#eyebrow { color: #868FA6; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
QLabel#pageTitle { color: #1C2640; font-size: 29px; font-weight: 800; }
QLabel#pageDescription { color: #768198; font-size: 13px; }
QLabel#sectionTitle { color: #27324B; font-size: 17px; font-weight: 750; }
QLabel#cardTitle { color: #27324B; font-size: 14px; font-weight: 750; }
QLabel#bodyText { color: #737E96; font-size: 12px; }
QLabel#subtle { color: #8993A9; font-size: 12px; }
QLabel#micro { color: #96A0B5; font-size: 11px; }
QLabel#number { color: #4835D1; font-size: 26px; font-weight: 800; }
QLabel#pill { color: #5D4CE2; background-color: #EFECFF; border-radius: 11px; padding: 5px 12px; font-size: 11px; font-weight: 700; }
QLabel#goodPill { color: #188368; background-color: #E7F8F2; border-radius: 11px; padding: 6px 11px; font-size: 11px; font-weight: 700; }
QLabel#warningPill { color: #986522; background-color: #FFF5E5; border-radius: 11px; padding: 6px 11px; font-size: 11px; font-weight: 700; }
QFrame#card, QFrame#optionCard { background: #FFFFFF; border: 1px solid #E7EAF3; border-radius: 18px; }
QFrame#innerCard { background: #F8F9FF; border: 1px solid #EAEDF7; border-radius: 13px; }
QFrame#hero { background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #452FBF, stop:0.55 #654CE7, stop:1 #8167F7); border: none; border-radius: 20px; }
QLabel#heroEyebrow { color: #C8BEFF; font-size: 11px; font-weight: 700; }
QLabel#heroTitle { color: #FFFFFF; font-size: 24px; font-weight: 800; }
QLabel#heroDescription { color: #E2DCFF; font-size: 13px; }
QLabel#heroBadge { color: #F7F6FF; background: #6550D8; border-radius: 11px; padding: 7px 13px; font-size: 11px; }
QPushButton { font-family: "Arial", "Helvetica Neue", sans-serif; }
QPushButton#primaryButton { color: #FFFFFF; background: #6347E9; border: 1px solid #6347E9; border-radius: 11px; padding: 11px 17px; font-size: 12px; font-weight: 700; }
QPushButton#primaryButton:hover { background: #5034D6; border-color: #5034D6; }
QPushButton#heroButton { color: #4934C7; background: #FFFFFF; border: none; border-radius: 11px; padding: 11px 17px; font-size: 12px; font-weight: 750; }
QPushButton#heroButton:hover { background: #EEEAFF; }
QPushButton#secondaryButton { background: #FFFFFF; border: 1px solid #DDE2F0; color: #465373; border-radius: 11px; padding: 10px 15px; font-size: 12px; font-weight: 700; }
QPushButton#secondaryButton:hover { background: #F7F5FF; border-color: #A99CF4; }
QPushButton#presetButton { background: #FFFFFF; color: #29334A; border: 1px solid #E2E7F1; border-radius: 15px; padding: 18px; text-align: left; font-size: 13px; font-weight: 700; }
QPushButton#presetButton:hover { border: 2px solid #A89AF5; background: #FBFAFF; }
QPushButton#presetButton:checked { border: 2px solid #7456EE; background: #F7F4FF; color: #4C35BE; }
QPushButton#miniLink { color: #6547DE; background: transparent; border: none; text-align: left; font-size: 12px; font-weight: 700; }
QPushButton#miniLink:hover { color: #4026AD; }
QPushButton#resetButton { background: transparent; border: 1px solid #DAE0EC; border-radius: 9px; padding: 8px 12px; color: #6D7890; font-size: 11px; }
QPushButton#resetButton:hover { background: #FFFFFF; }
QLineEdit { background: #FFFFFF; color: #27324B; border: 1px solid #DCE1ED; border-radius: 11px; padding: 11px 13px; font-size: 13px; }
QLineEdit:focus { border: 2px solid #785EEC; }
QSlider::groove:horizontal { height: 6px; border-radius: 3px; background: #E7E8F3; }
QSlider::handle:horizontal { width: 17px; height: 17px; margin: -6px 0; border-radius: 8px; background: #694EEA; }
QSlider::sub-page:horizontal { border-radius: 3px; background: #7762E9; }
QScrollArea { background: transparent; border: none; }
QScrollArea QWidget#scrollContent { background: transparent; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 3px; }
QScrollBar::handle:vertical { background: #D7DCEE; border-radius: 4px; min-height: 30px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QFrame#footerBar { border-top: 1px solid #E8ECF4; background: #FFFFFF; }
QLabel#footerText { color: #8791A6; font-size: 11px; }
QPushButton:focus { outline: 2px solid #7D68EF; }

/* Keyboard access and disabled-state feedback */
QPushButton:disabled { color: #A6ADC0; background: #F2F3F7; border-color: #E5E8F0; }
QPushButton#navButton:focus, QPushButton#presetButton:focus { border: 2px solid #9C8BEF; }
QFrame#card:hover { border-color: #DADDF0; }

/* Accessible options for the SmartInterface configuration panel. */
QComboBox { background: #FFFFFF; color: #26314A; border: 1px solid #DCE1ED;
            border-radius: 10px; padding: 10px 14px; min-height: 22px; font-size: 13px; }
QComboBox:focus { border: 2px solid #785EEC; }
QComboBox QAbstractItemView { background: #FFFFFF; color: #27324B;
                              selection-background-color: #EEE9FF; }
