/* AccessShift Focus 2.0 — one simple header, one clear column.
   Layout geometry is controlled by Qt layouts, not CSS positioning. */
QWidget#appRoot, QWidget#scrollContent, QWidget#contentBody, QStackedWidget#pageStack {
    background: #F5F6FA;
    color: #22263B;
}
QLabel {
    background: transparent;
    border: none;
    color: #25293A;
    font-family: "Arial", "Helvetica Neue", sans-serif;
}
QFrame#topbar {
    background: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E4E6EF;
}
QLabel#brandSymbol {
    background: #6354D8;
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 22px;
    font-weight: 800;
}
QLabel#brandName { font-size: 19px; font-weight: 750; color: #202336; }
QLabel#brandSub { font-size: 9px; color: #7D8192; }
QLabel#statusTag {
    background: #F2F5E8; color: #4E6835;
    border-radius: 8px; padding: 9px 12px;
    font-size: 10px; font-weight: 700;
}
QPushButton {
    font-family: "Arial", "Helvetica Neue", sans-serif;
    font-size: 13px;
    font-weight: 650;
    outline: none;
}
QPushButton#navTab {
    background: transparent; border: 1px solid transparent;
    border-radius: 10px; color: #717487;
    padding: 7px 14px; min-height: 27px;
}
QPushButton#navTab:hover { background: #F4F2FF; color: #5145B5; }
QPushButton#navTab:checked {
    background: #F0EEFE; border: 1px solid #E2DDFF; color: #5145B5;
}
QLabel#eyebrow { font-size: 10px; font-weight: 750; color: #6758C6; }
QLabel#pageTitle { font-size: 27px; font-weight: 750; color: #202336; }
QLabel#pageDescription { font-size: 13px; color: #656A7F; }
QLabel#sectionTitle { font-size: 16px; font-weight: 700; }
QLabel#sectionHint { font-size: 11px; color: #8A8FA0; }
QLabel#cardTitle { font-size: 17px; font-weight: 700; }
QLabel#fieldLabel { font-size: 13px; color: #33384D; font-weight: 700; }
QLabel#supportText, QLabel#body, QLabel#toolDetail { font-size: 12px; color: #697084; }
QLabel#toolTitle { font-size: 15px; color: #22263B; font-weight: 700; }
QLabel#toolNumber {
    background: #F0EDFF; border-radius: 11px; color: #6655D3;
    font-size: 12px; font-weight: 800;
}
QFrame#presetBar, QFrame#toolList, QFrame#surface {
    background: #FFFFFF;
    border: 1px solid #E2E5EF;
    border-radius: 16px;
}
QFrame#toolLine { background: transparent; border: none; }
QFrame#lineDivider { background: #ECEEF3; border: none; }
QFrame#tabsBar { background: #EBEDF4; border-radius: 13px; }
QFrame#inlineToggle {
    background: #F9F9FC; border: 1px solid #E8E9F0; border-radius: 12px;
}
QPushButton#primaryButton, QPushButton#secondaryButton, QPushButton#detailTab {
    min-height: 24px; padding: 10px 17px; border-radius: 10px;
    font-size: 13px; font-weight: 700;
}
QPushButton#primaryButton {
    background: #6252D9; border: 1px solid #6252D9; color: #FFFFFF;
}
QPushButton#primaryButton:hover { background: #4D40B9; }
QPushButton#secondaryButton {
    background: #FFFFFF; color: #32364A; border: 1px solid #D7DAE5;
}
QPushButton#secondaryButton:hover { background: #F5F3FF; border-color: #BBB3ED; }
QPushButton#detailTab { background: transparent; border: 1px solid transparent; color: #6B6F81; }
QPushButton#detailTab:checked {
    background: #FFFFFF; color: #5043B4; border: 1px solid #DFDCEB;
}
QPushButton:disabled { background: #F0F1F4; color: #969BAA; border: 1px solid #E5E6EC; }
QPushButton:focus { border: 2px solid #7965E9; }
QLineEdit, QTextEdit, QComboBox {
    background: #FFFFFF; color: #252B3F; border: 1px solid #D8DCE8;
    border-radius: 10px; padding: 9px 12px; font-size: 13px; min-height: 24px;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus { border: 2px solid #6553DD; }
QComboBox QAbstractItemView {
    background: #FFFFFF; color: #22263B; selection-background-color: #EDE9FF;
}
QLabel#valuePill {
    background: #F1F0FF; color: #4D3CB1; border: 1px solid #E2DEFF;
    border-radius: 9px; padding: 7px 10px; font-size: 12px; font-weight: 700;
}
QSlider::groove:horizontal { height: 7px; background: #E6E6F0; border-radius: 3px; }
QSlider::sub-page:horizontal { background: #8B7CEC; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #6554D8; border-radius: 10px; height: 20px;
    width: 20px; margin: -7px 0;
}
QFrame#appFooter {
    background: #FFFFFF; border: none; border-top: 1px solid #E6E8EE;
}
QLabel#footerText { color: #7B8092; font-size: 10px; }
QScrollArea#pageScroll, QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 9px; }
QScrollBar::handle:vertical { background: #D0D1DD; min-height: 32px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
