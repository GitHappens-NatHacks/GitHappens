{
  "name": "truecursor",
  "private": true,
  "version": "0.1.0",
  "description": "TrueCursor desktop monorepo orchestrator",
  "scripts": {
    "dev": "make dev",
    "dev:backend": ".venv/bin/python -m backend.sidecar_main 8000",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "make build",
    "build:backend": ".venv/bin/python scripts/build_backend.py",
    "build:frontend": "npm --prefix frontend run build",
    "test": "make test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
