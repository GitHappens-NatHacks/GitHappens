+    def show_movement_tests(self, visible):
+        if visible and self.test_view is None:
+            from pathlib import Path
+            from PySide6.QtCore import QUrl
+            from PySide6.QtWebEngineWidgets import QWebEngineView
+
+            view = QWebEngineView(self)
+            view.setAccessibleName("Movement tests")
+            view.setMinimumHeight(660)
+            view.page().profile().downloadRequested.connect(self.save_test_download)
+            page = Path(__file__).with_name("mouse_tests.html")
+            view.load(QUrl.fromLocalFile(str(page.resolve())))
+            self.layout().insertWidget(self.layout().indexOf(self.test_toggle) + 1, view)
+            self.test_view = view
+        if self.test_view is not None:
+            self.test_view.setVisible(visible)
+
+    def save_test_download(self, request):
+        from pathlib import Path
+        from PySide6.QtWidgets import QFileDialog
+
+        if self.test_view is None or request.page() != self.test_view.page():
+            return
+        filename, _ = QFileDialog.getSaveFileName(self, "Save movement test data",
+                                                   request.downloadFileName())
+        if filename:
+            path = Path(filename)
+            request.setDownloadDirectory(str(path.parent))
+            request.setDownloadFileName(path.name)
+            request.accept()
+        else:
+            request.cancel()
 
     def set_theme(self, t: theme_mod.Theme) -> None:
